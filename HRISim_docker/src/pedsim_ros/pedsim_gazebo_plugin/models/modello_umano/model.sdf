<?xml version='1.0'?>
<sdf version='1.5'>
  <model name='modello_umano'>
    <static>true</static>
    <link name='link'>
      <!-- Ruoto il link di 90 gradi (1.5708 rad) per allineare l'asse della mesh con la direzione di Pedsim -->
      <pose>0 0 0 0 0 1.5708</pose>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>model://person_walking/meshes/walking.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://person_walking/meshes/walking.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
